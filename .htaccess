# ============================================================
#  村越じゅんた 公式サイト — Apache 設定（さくらのレンタルサーバ用）
#  本番ドメイン: junta-murakoshi.jp
#
#  このファイルは GitHub の master ブランチで管理し、自動デプロイで反映される。
#
#  ⚠️ サーバー上で直接編集しても、次回デプロイでは元に戻りません。
#     デプロイは「前回アップロードした内容の記録」との差分だけを送る方式のため、
#     サーバー側の手編集は検知されず、そのまま残り続けます。
#     本番とGitHubが 食い違いになる原因になるので、変更は必ずGitHub側で行うこと。
#
#  ⚠️ さくらコントロールパネルの「HTTPSに転送する」は OFF のままにすること。
#     転送はこのファイルに一本化する（設定が2箇所に分かれると追跡できなくなるため）。
#
#  ⚠️ 万一このファイルが原因でサイト全体が 500 エラーになった場合：
#     GitHub 上でこのファイルを削除して再デプロイすれば復旧できる
#     （削除は差分として検出され、サーバー上からも消える）。
#     サーバーにログインする必要はない。
# ============================================================

# --- 1) 正規URLへの統一（https + wwwなし + 本番ドメイン） ---
# 転送の根拠: さくらインターネット公式「.htaccessによるアクセス制御をしたい」
#   https://help.sakura.ad.jp/rs/2214/ （確認日 2026-10-12）
#   → 同ページの「www.無しドメイン統一の常時SSL化」の記述例に準拠。
#     さくらでは HTTPS の判定に %{HTTPS} を用いる（X-Sakura-Forwarded-For は公式が非推奨）。
#
# (1) と (2) を [OR] で結合せず、独立した2本のルールに分けている。
#     こうするとホスト名が一致した時点で (1) は発火しなくなるため、
#     ホスト名まわりの誤設定が無限リダイレクトに直結しない。
<IfModule mod_rewrite.c>
RewriteEngine On

# SSL証明書の自動更新用パスは転送の対象外にする
RewriteRule ^\.well-known/ - [L]

# (1) ホスト名の正規化
#     www付き / 初期ドメイン経由(junta-murakoshi.sakura.ne.jp/seiji/) / IP直打ち
#     → すべて https://junta-murakoshi.jp/ へ
#     ※ %{REQUEST_URI} ではなく $1 を使う。.htaccess のあるディレクトリからの
#        相対パスで照合されるため、初期ドメイン経由の /seiji/... も正しい位置に着地する。
RewriteCond %{HTTP_HOST} !^junta-murakoshi\.jp$ [NC]
RewriteRule ^(.*)$ https://junta-murakoshi.jp/$1 [R=301,L]

# (2) http → https（さくら公式の記述例どおり）
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- 2) カスタムエラーページ ---
ErrorDocument 404 /404.html

# --- 3) ディレクトリ一覧の抑止 ---
# assets/ 配下に index ファイルが無いため、これが無いと画像が一覧表示されうる。
# ※ AllowOverride で Options が禁止された環境では 500 になる。その場合はこの行を消し、
#    下の IndexIgnore 版（コメントアウト中）に切り替えること。
Options -Indexes
# <IfModule mod_autoindex.c>
#   IndexIgnore *
# </IfModule>

# --- 4) セキュリティヘッダ ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # CSP: 実際の読み込み先だけを許可する。
  #   style-src の 'unsafe-inline' は 404.html のインライン <style> と
  #   HTML内の style 属性のために必要（script の 'unsafe-inline' は不要にしてある）。
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'self'"

  # HSTS（https以外での接続をブラウザ側に禁止させる設定）
  # ⚠️ 有効化の判断基準: 無料SSLの「自動更新が1回成功した」ことを確認してから。
  #    先に入れると、万一SSLが切れたときにブラウザがアクセスを拒否し、復旧が難しくなる。
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- 5) 公開不要なファイルの遮断 ---
# （デプロイ対象から除外済みだが、取りこぼしに備えた二重の防御）
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|yml|yaml|py|sh|bak|log)$">
    Require all denied
  </FilesMatch>
  # .ftp-deploy-sync-state.json はデプロイツールが公開ディレクトリに置く状態ファイル。
  # 全配信ファイル名とハッシュの一覧が入っているため、HTTP からは読めないようにする。
  # （ツール自身は FTP で読むので、遮断しても動作に影響しない）
  <FilesMatch "^(\.htaccess|\.gitignore|\.ftp-deploy-sync-state\.json|README|LICENSE)">
    Require all denied
  </FilesMatch>
</IfModule>

# --- 6) 静的ファイルのキャッシュ ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/jpeg              "access plus 30 days"
  # HTML と JSON はキャッシュしない（更新が即座に反映されるように）
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType application/json        "access plus 0 seconds"
</IfModule>
